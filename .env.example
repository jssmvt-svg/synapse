# ─────────────────────────────────────────────────────────────────
# Synapse — Variables d'environnement (exemple)
# Copier ce fichier en `.env` pour le développement local.
# En production (Replit), renseigner ces clés dans l'onglet Secrets.
# NE JAMAIS committer le fichier `.env` réel.
# ─────────────────────────────────────────────────────────────────

# Port d'écoute du serveur (Replit fournit PORT automatiquement)
PORT=5000

# URL publique de l'application (sans slash final)
APP_URL=https://synapse.replit.app

# Origines autorisées pour CORS, séparées par des virgules.
# Laisser vide pour autoriser toutes les origines (déconseillé en prod).
ALLOWED_ORIGINS=https://synapse.replit.app

# Base de données — Supabase (Postgres).
# Récupérer la chaîne "Transaction pooler" dans Supabase → bouton Connect
# (port 6543, host *.pooler.supabase.com), et remplacer [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Secret de signature JWT — OBLIGATOIRE en production.
# Générer une valeur forte : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string

# Clé API Anthropic (Claude) — génération des flashcards et synthèses.
# PAS NÉCESSAIRE pour l'instant : la génération IA est désactivée côté interface.
# À ajouter quand la fonctionnalité sera réactivée.
ANTHROPIC_API_KEY=sk-ant-xxx

# Clé API Resend — envoi des emails transactionnels (bienvenue, essai gratuit
# accordé/refusé/terminé, confirmation de paiement). Sans elle, les emails
# sont simplement journalisés dans la console (aucune erreur bloquante).
RESEND_API_KEY=re_xxx

# Adresse d'expédition des emails (domaine vérifié dans Resend).
EMAIL_FROM=Synapse <noreply@synapse.replit.app>

# Adresse recevant les notifications internes (nouvelle demande d'essai 48h).
ADMIN_NOTIFICATION_EMAIL=jssmvt@gmail.com

NODE_ENV=development
