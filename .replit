run = "npm install && npm run build --workspace=client && npm run start --workspace=server"
modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3001
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[deployment]
run = ["sh", "-c", "npm install && npm run build --workspace=client && npm run start --workspace=server"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true

[userenv]

[userenv.shared]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

# ⚠️ SÉCURITÉ — Ne JAMAIS mettre de secrets en clair ici (ce fichier est versionné).
# Les secrets (DATABASE_URL, JWT_SECRET, ANTHROPIC_API_KEY) doivent être
# renseignés dans l'onglet "Secrets" de Replit (Tools → Secrets).
